# Gewinnspiel Demo App — Environment Variables
# Kopiere diese Datei als .env und passe die Werte an (wird durch setup.sh automatisch generiert)

# Datenbank
POSTGRES_USER=gewinnspiel
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=gewinnspiel_db
DATABASE_URL=postgresql://gewinnspiel:change_me_in_production@postgres:5432/gewinnspiel_db

# Authentifizierung
# SWAO CRYPTO-JWT: Symmetrischer HS256-Key — kein asymmetrisches RSA/EC
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string_in_production
JWT_EXPIRES_IN=7d

# Externe APIs
# SWAO EGR-01: Alphavantage — non-sovereign, US-hosted API
ALPHAVANTAGE_API_KEY=demo

# Ports
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Node
NODE_ENV=development
